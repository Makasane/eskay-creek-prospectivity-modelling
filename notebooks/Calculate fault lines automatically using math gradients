print("🧲 Computing First Vertical Derivative (FVD) from raw magnetic grid...")

with rasterio.open(raster_path) as src:
    mag_array = src.read(1)
    mag_array = np.where(mag_array == src.nodata, np.nan, mag_array)
    
    # Calculate analytical horizontal and vertical spatial changes
    dy, dx = np.gradient(mag_array)
    fvd_array = np.sqrt(dx**2 + dy**2)
    
    # Min-Max standardisation across spatial grid boundaries
    fvd_min, fvd_max = np.nanmin(fvd_array), np.nanmax(fvd_array)
    fvd_norm = (fvd_array - fvd_min) / (fvd_max - fvd_min)
    fvd_norm[np.isnan(mag_array)] = np.nan

plt.figure(figsize=(12, 10), dpi=200)
ax = plt.subplot(111)
im = ax.imshow(fvd_norm, cmap='inferno', extent=extent, interpolation='none', origin='upper')
ax.set_aspect('equal')
cbar = plt.colorbar(im, ax=ax, shrink=0.7)
cbar.set_label('Normalized Magnetic Derivative Gradient (0.0 - 1.0)', fontsize=11, fontweight='bold')

plt.title('Calculated First Vertical Derivative (FVD) Grid Layer\n(Automated Structural Lineament and Fault Vector Inference)', fontsize=13, fontweight='bold', pad=15)
plt.xlabel('Easting (m)', fontsize=11)
plt.ylabel('Northing (m)', fontsize=11)
plt.grid(True, linestyle=':', alpha=0.5)

plt.savefig('/content/github_portfolio/assets/images/geophysical_fvd_gradient.png', bbox_inches='tight', dpi=300)
plt.show()
